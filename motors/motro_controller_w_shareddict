pi.set_mode(13, pigpio.OUTPUT)
# Set the PWM frequency for the servo to 50 Hz
pi.set_PWM_frequency(13, 50)


# --- Stepper Motor Control Function ---

def stepper_worker(movement_queue, shared_data):
    """
    Process function that listens for commands on a queue and controls the stepper motor.
    """
    while True:
        # Retrieve a command from the movement queue; this will block until a command is available
        command = movement_queue.get()

        # If the command is None, it's a signal to terminate the process
        if command is None:
            break

        # Unpack the command tuple
        direction, degrees, delay = command

        # Calculate the ideal number of microsteps required for the requested degrees
        # This is based on the motor's step angle and microstepping setting
        ideal_microsteps = degrees / 0.05625

        # To correct for fractional steps over time, add the cumulative error from previous moves
        total_microsteps_to_consider = ideal_microsteps + shared_data['cumulative_error']

        # Round to the nearest whole number of microsteps to execute
        actual_microsteps_to_take = round(total_microsteps_to_consider)

        # Calculate the new cumulative error for the next move
        shared_data['cumulative_error'] = total_microsteps_to_consider - actual_microsteps_to_take

        # Set the direction of the stepper motor based on the command
        if direction == 'right':
            GPIO.output(2, True)
        else:
            GPIO.output(2, False)

        # Execute the steps
        for _ in range(actual_microsteps_to_take):
            # Generate a pulse on the step pin to move the motor one microstep
            GPIO.output(3, GPIO.HIGH)
            sleep(delay)
            GPIO.output(3, GPIO.LOW)
            sleep(delay)

        # Calculate the actual degrees moved in this operation
        actual_degrees_this_move = actual_microsteps_to_take * 0.05625

        # Update the shared dictionary with the new position
        if direction == 'left':
            shared_data['stepper_degrees'] -= actual_degrees_this_move
        else:
            shared_data['stepper_degrees'] += actual_degrees_this_move

# --- Servo Motor Control Function ---

def smooth_servo_move(target_degrees, shared_data, step_delay=0.01, step_size=1):
    """
    Moves the servo motor to a target position in small, smooth increments.

    Args:
        target_degrees (int): The final angle for the servo.
        shared_data (Manager.dict): The shared dictionary holding the current servo angle.
        step_delay (float): The delay between each small step.
        step_size (int): The number of degrees to move in each increment.
    """
    # Get the current position from the shared dictionary
    current_degrees = shared_data['servo_degrees']

    # Determine the direction and range of movement
    if target_degrees > current_degrees:
        # Move up
        for degrees in range(current_degrees, target_degrees + 1, step_size):
            # Calculate the pulse width for the target angle
            pulse_width = 500 + (degrees / 0.09)
            # Set the servo pulse width
            pi.set_servo_pulsewidth(13, pulse_width)
            # Update the current position in the shared dictionary
            shared_data['servo_degrees'] = degrees
            # Wait for a short period
            sleep(step_delay)
    else:
        # Move down
        for degrees in range(current_degrees, target_degrees - 1, -step_size):
            # Calculate the pulse width for the target angle
            pulse_width = 500 + (degrees / 0.09)
            # Set the servo pulse width
            pi.set_servo_pulsewidth(13, pulse_width)
            # Update the current position in the shared dictionary
            shared_data['servo_degrees'] = degrees
            # Wait for a short period
            sleep(step_delay)


# --- General Movement Function ---

def move(direction, degrees, delay, movement_queue, shared_data):
    """
    A unified function to command either the stepper or the servo motor.
    """
    # Check if the command is for the stepper motor
    if direction in ['left', 'right']:
        # Create a command tuple for the stepper
        command = (direction, degrees, delay)
        # Add the command to the stepper's movement queue
        movement_queue.put(command)
    # Check if the command is for the servo motor
    elif direction in ['up', 'down']:
        # Determine the target degrees based on the direction
        target_degrees = shared_data['servo_degrees']
        if direction == 'up':
            target_degrees += degrees
        else:
            target_degrees -= degrees
        
        # Ensure the target degrees are within a reasonable range (e.g., 0-180)
        target_degrees = max(0, min(180, target_degrees))
        
        # Call the smooth servo movement function
        smooth_servo_move(target_degrees, shared_data)


# --- Main Execution Block ---

if __name__ == '__main__':
    # Create a Manager object to manage shared state between processes
    with Manager() as manager:
        # Create a shared dictionary to store motor positions and other data
        shared_data = manager.dict()
        # Initialize the shared data for the stepper and servo motors
        shared_data['stepper_degrees'] = 0.0
        shared_data['cumulative_error'] = 0.0
        shared_data['servo_degrees'] = 0

        # Create a queue for passing movement commands to the stepper process
        movement_queue = Queue()

        # Create the stepper motor worker process
        stepper_process = Process(target=stepper_worker, args=(movement_queue, shared_data))
        # Start the stepper process
        stepper_process.start()

        # --- Example Usage ---
        
        # Move the servo to the 45-degree position
        move('up', 45, 0.1, movement_queue, shared_data)
        sleep(1)

        # A loop to demonstrate simultaneous stepper and servo movement
        for i in range(5):
            # Command the servo to move to a new position
            move('up', (i + 1) * 10, 0.5, movement_queue, shared_data)
            sleep(0.1) # Short delay
            
            # Queue a movement command for the stepper motor to move left
            move('left', i * 2, 0.0001, movement_queue, shared_data)
            sleep(0.1) # Short delay

            # Command the servo to move to a new position
            move('down', (i + 1) * 5, 0.5, movement_queue, shared_data)
            sleep(0.1) # Short delay
            
            # Queue a movement command for the stepper motor to move right
            move('right', i * 2, 0.0001, movement_queue, shared_data)
            sleep(0.2) # Short delay


        # Send a signal to the queue to stop the stepper process
        movement_queue.put(None)
        
        # Wait for the stepper process to finish its tasks and terminate
        stepper_process.join()

        # --- Cleanup ---

        # Disable the stepper motor to save power and prevent overheating
        GPIO.output(4, GPIO.HIGH)
        
        # Stop the PWM signal to the servo
        pi.set_servo_pulsewidth(13, 0)
        
        # Stop the pigpio library connection
        pi.stop()
